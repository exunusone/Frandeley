SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Keep registrations closed until the social pre-launch is complete.
PILOT_SIGNUPS_OPEN=false
# Public Cloudflare Turnstile site key and server-only secret key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Server-only Supabase key for the private interest counter RPC.
SUPABASE_SERVICE_ROLE_KEY=
# Optional stable HMAC key for browser deduplication (otherwise the Supabase server key is used).
INTEREST_HASH_SECRET=
# Server-only Resend credentials. Never add secrets to NEXT_PUBLIC_* or commit them.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=Frandeley
RESEND_NOTIFICATION_EMAIL=
RESEND_NEWSLETTER_TOPIC_ID=
